// V4L2 Camera HAL with media controller pipeline setup for the p4note
// cameras. Copied from hardware/libhardware/modules/camera/3_4.
//
// This is an Android.bp, not the Android.mk it was copied with: Android.mk
// files below device/samsung/p4note/Android.mk are never picked up.
//
// The module is a vendor module because it is loaded by the vendor camera
// provider (android.hardware.camera.provider@2.4-service), whose linker
// namespace can't see /system/lib/hw. That rules out libcamera_client (its
// CameraMetadata comes from android.hardware.camera.common-helper instead,
// see compat/) and libchrome (not visible to device/samsung, and replaced by
// libbase and std in arc/).
cc_library_shared {
    name: "camera.v4l2_custom",
    vendor: true,
    relative_install_path: "hw",

    srcs: [
        "arc/cached_frame.cpp",
        "arc/exif_utils.cpp",
        "arc/frame_buffer.cpp",
        "arc/image_processor.cpp",
        "arc/jpeg_compressor.cpp",
        "camera.cpp",
        "capture_request.cpp",
        "format_metadata_factory.cpp",
        "media_pipeline.cpp",
        "metadata/boottime_state_delegate.cpp",
        "metadata/enum_converter.cpp",
        "metadata/metadata.cpp",
        "metadata/metadata_reader.cpp",
        "pipeline_configs.cpp",
        "request_tracker.cpp",
        "static_properties.cpp",
        "stream_format.cpp",
        "v4l2_camera.cpp",
        "v4l2_camera_hal.cpp",
        "v4l2_metadata_factory.cpp",
        "v4l2_wrapper.cpp",
    ],

    // Provides camera/CameraMetadata.h.
    local_include_dirs: ["compat"],
    include_dirs: [
        "system/media/camera/include",
    ],

    shared_libs: [
        "libbase",
        "libcamera_metadata",
        "libcutils",
        "libexif",
        "libhardware",
        "libhidlbase",
        "libjpeg",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],
    static_libs: [
        "android.hardware.camera.common-helper",
        "libyuv_static",
    ],
    header_libs: ["libgtest_prod_headers"],

    cflags: [
        "-DHAVE_JPEG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fno-short-enums",
        "-fvisibility=hidden",
    ],
}
