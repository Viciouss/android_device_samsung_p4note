<?xml version="1.0" encoding="utf-8"?>
<!--
    Codecs of the Exynos4412 MFC 5.1 (s5p-mfc) through v4l2_codec2.

    The decoder only outputs tiled NV12MT into MMAP buffers. v4l2_codec2
    detiles each frame with the CPU into the graphic block (tiled output
    mode in V4L2Decoder). Listed first, so it is picked before
    c2.android.avc.decoder for H.264 playback.
-->
<Included>
    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc">
            <!-- Same datasheet limits as the encoder below. -->
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="block-count" range="1-8160" /> <!-- 1920x1088 in 16x16 blocks -->
            <Limit name="blocks-per-second" range="1-244800" /> <!-- 1080p30 -->
            <Limit name="bitrate" range="1-20000000" />
        </MediaCodec>
    </Decoders>
    <Encoders>
        <MediaCodec name="c2.v4l2.avc.encoder" type="video/avc">
            <!--
                Exynos 4412 datasheet: H.264 Baseline/Main/High up to Level 4.0,
                1920x1080 at 30 fps and 20 Mbps, 32x32 minimum, arbitrary input
                size. The driver exposes the same profiles and level range.
            -->
            <Limit name="size" min="32x32" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="block-count" range="1-8160" /> <!-- 1920x1088 in 16x16 blocks -->
            <Limit name="blocks-per-second" range="1-244800" /> <!-- 1080p30 -->
            <Limit name="bitrate" range="1-20000000" />
        </MediaCodec>
    </Encoders>
</Included>
