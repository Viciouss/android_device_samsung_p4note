subsystem dma_heap
   devname uevent_devpath
   dirname /dev/dma_heap

/dev/ion                                               0666    system       graphics
/dev/graphics/*                                        0660    root         graphics
/dev/dri/*                                             0666    root         graphics
/dev/pvr_sync                                          0666    system       graphics
/dev/sw_sync                                           0666    system       graphics
/dev/composer                                          0660    system       graphics
/dev/video*                                            0660    system       camera
/dev/video0                                            0666    media        media
/dev/video1                                            0666    media        media
/dev/video2                                            0666    media        media
/dev/video3                                            0666    media        media
/dev/media*                                            0660    system       camera
/dev/v4l-subdev*                                       0660    system       camera
/dev/tee0                                              0660    system       keystore
/dev/teepriv0                                          0660    system       keystore
/dev/ttyUSB0                                           0666    system       system
/dev/block/platform/soc/12550000.mmc/by-name/USERDATA  0600    system       system
/dev/rfkill                                            0660    root         root
/dev/ion                                               0664    system       system
/dev/iio:device*                                       0660    system       system
/dev/wlan                                              0666    system       system
/dev/dma_heap/linux,cma	                               0666    system       graphics
/dev/dma_heap/system                                   0666    system       system

# LSM330DLC accel: sensor HAL (system) drives the triggered buffer
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  sampling_frequency              0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  buffer/enable                   0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  buffer/length                   0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  trigger/current_trigger         0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  scan_elements/in_accel_x_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  scan_elements/in_accel_y_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  scan_elements/in_accel_z_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-0019/iio:device*  scan_elements/in_timestamp_en   0664  system  system

# LSM330DLC gyro: sensor HAL (system) drives the triggered buffer
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  sampling_frequency                0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  buffer/enable                     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  buffer/length                     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  trigger/current_trigger           0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  scan_elements/in_anglvel_x_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  scan_elements/in_anglvel_y_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  scan_elements/in_anglvel_z_en     0664  system  system
/sys/devices/platform/soc/13870000.i2c/i2c-1/1-006b/iio:device*  scan_elements/in_timestamp_en     0664  system  system

# Flash LED (leds-sgm3140), switched as the torch by the camera provider
/sys/devices/platform/led-controller/leds/white:flash  brightness  0660  cameraserver  camera
